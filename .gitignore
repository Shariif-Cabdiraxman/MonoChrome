# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env files — never commit real secrets.
# .env.example IS tracked on purpose (templates must be shared).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
*.keystore

# editor / OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
*.swp


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deployment
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local logs
*.log

